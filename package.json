{
  "name": "rug",
  "private": true,
  "scripts": {
    "check:markdown": "node scripts/markdown.mjs --check",
    "format:markdown": "node scripts/markdown.mjs --write",
    "test:markdown": "node --test scripts/tests/*.test.mjs"
  },
  "devDependencies": {
    "@vscode/markdown-it-katex": "1.1.2",
    "katex": "0.19.1",
    "markdown-it": "14.3.3",
    "rumdl": "0.2.77"
  },
  "overrides": {
    "@vscode/markdown-it-katex": {
      "katex": "$katex"
    }
  }
}
