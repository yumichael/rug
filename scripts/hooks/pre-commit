#!/bin/sh
# Check indexed content without stashing or changing working-tree files.
set -eu
cd "$(git rev-parse --show-toplevel)"
rug_node=${RUG_NODE:-$(git config --local --get rug.nodeExecutable || true)}
if [ -z "$rug_node" ]; then
  rug_node=$(command -v node || true)
elif [ "${rug_node#*/}" = "$rug_node" ]; then
  rug_node=$(command -v "$rug_node" || true)
fi
if [ -z "$rug_node" ] || [ ! -x "$rug_node" ]; then
  echo 'Error: Node.js is unavailable. Run sh scripts/setup-rumdl.sh after installing Node.js and npm.' >&2
  exit 1
fi
git --no-pager diff --cached --check
"$rug_node" scripts/markdown.mjs --staged
# App and documentation commits do not require Python or uv.
if [ -n "$(git diff --cached --name-only --diff-filter=ACMR -- ':(glob)research/interactive/**/*.py' ':(glob)research/interactive/**/*.pyi' scripts/lint_staged_python.py ruff.toml)" ]; then
  if ! command -v uv >/dev/null 2>&1; then
    echo 'Error: Python files or Ruff configuration are staged. Install uv and run sh research/interactive/setup.sh.' >&2
    exit 1
  fi
  unset VIRTUAL_ENV
  uv run --locked --project research/interactive python scripts/lint_staged_python.py
fi
