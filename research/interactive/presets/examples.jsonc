{
  // Native pattern specifications used throughout the notebook.
  "xor": {
    "n": 64,
    "shape": [32, 32],
    "sampling": "checkerboard_same",
    "K": 64,
    "combine": "xor",
    "post": [["pow", 2]],
    "M": 128,
  },
  "squared_and": {
    "n": 64,
    "pre": [["pow", 2]],
    "K": 64,
    "combine": "and",
    "M": 64,
  },
  "polynomial": {
    "n": 64,
    "pre": [["poly", [0, 0, -1, 0, 2]]],
    "K": 64,
    "combine": "or",
    "post": [["poly", [0, 3, 1]]],
    "M": 256,
  },
  "multiple_features": {
    "n": 64,
    "K": 64,
    "combine": ["xor", "absdiff"],
    "expression": "z0 + z1**2",
    "M": 256,
  },
  // Each string specifies one DSL channel.
  "dsl": [
    "64;;^;diag1:**2:%128:map01;cmr.infinity",
  ],
}
