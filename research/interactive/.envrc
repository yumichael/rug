# Activate an existing research environment; installation remains explicit.
watch_file pyproject.toml uv.lock .python-version
rug_research_env=$(expand_path "${UV_PROJECT_ENVIRONMENT:-.venv}")
watch_file "$rug_research_env/pyvenv.cfg"
if [ -x "$rug_research_env/bin/python" ]; then
    export UV_PROJECT_ENVIRONMENT="$rug_research_env"
    export VIRTUAL_ENV="$rug_research_env"
    PATH_add "$rug_research_env/bin"
else
    log_status 'Research environment not installed. Run sh setup.sh to install it.'
fi
unset rug_research_env
