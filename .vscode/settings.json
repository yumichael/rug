{
  "files.readonlyInclude": {
    "**/*": true,
  },
  "files.associations": {
    "**/.vscode/*.json": "jsonc",
  },
  "json.schemas": [
    {
      "fileMatch": ["/research/interactive/presets/*.jsonc"],
      "schema": { "allowTrailingCommas": true },
    },
  ],
  "[markdown]": {
    "editor.defaultFormatter": "rvben.rumdl",
    "editor.formatOnSave": true,
  },
  "rumdl.server.path": "node_modules/.bin/rumdl",
}
